#!/usr/bin/env bash
# Tracked pre-push hook — see wiki:ci-local-gates-hooks.
#
# Installed by `make hooks` (sets core.hooksPath = scripts/git-hooks).
# Runs on `git push` in any worktree of this repo.
#
# Scope: heavy gates that mirror the CI PR-gate semantics, locally.
# Goal: ~1 min on a typical push. One push per task, so cost is fine.
#
# Checks (run only on pushes that carry code):
#   make lint-new      — golangci-lint run --new-from-merge-base=origin/dev
#                        (same flag the PR CI uses; pre-existing debt is
#                        silent by design — see Phase 30.16)
#   make web-typecheck  — tsc --noEmit on web/src (catches TS errors that
#                         would break web-build; Task 44)
#   make test          — go test ./... -race (Go test cache ENABLED — no
#                        -count=1, so an unchanged tree re-runs in seconds)
#                        + vitest. The full uncached `make test-full` is the
#                        CI backstop on push to dev.
#
# Deletion-only pushes (e.g. deleting a merged branch via
# `git push origin --delete <branch>`) are skipped — no code crosses
# the wire, so the gates have nothing to check.  The hook reads stdin
# line-by-line; if every ref update has a zero local sha it exits 0
# immediately.  Mixed pushes (any code update alongside a deletion)
# still run the full gate.
#
# Exits non-zero to block the push. Set SKIP_ORENDA_HOOKS=1 to bypass.
# `--no-verify` is forbidden by AGENTS.md.

set -euo pipefail

if [[ "${SKIP_ORENDA_HOOKS:-0}" == "1" ]]; then
  echo "pre-push: SKIP_ORENDA_HOOKS=1, skipping"
  exit 0
fi

# --- Deletion-only detection ---
# Git sends one line per ref update on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
# A deletion means local sha is the all-zeros SHA.
# If every line is a deletion (or stdin is empty), skip the gates —
# no code crosses the wire so there is nothing to gate.
zero="0000000000000000000000000000000000000000"
deletion_only=1
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [[ "$local_sha" != "$zero" ]] && deletion_only=0
done
if [[ "$deletion_only" == "1" ]]; then
  echo "pre-push: deletion-only push — skipping gates"
  exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Git exports GIT_DIR & friends into the hook environment. Anything we
# spawn that shells out to git (go test ./... — e.g. internal/backup tests
# running `git init --bare` in a tmpdir — inherits them and silently writes
# into THIS repo's shared .git/config: core.bare=true, origin=<tmpdir>,
# user=test@…). That corruption has already bricked the main checkout once.
# Drop the whole GIT_* surface before make; the checks below only need a
# clean worktree repo, which git re-discovers from the cwd.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_NAMESPACE \
      GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES \
      GIT_QUARANTINE_PATH GIT_PREFIX GIT_CEILING_DIRECTORIES

# A push from a brand-new worktree may not have origin/dev fetched yet.
# `make lint-new` resolves origin/dev at run-time; if it's missing, fetch
# it now so the first push on a new worktree still gates cleanly.
if ! git rev-parse --verify --quiet origin/dev >/dev/null; then
  echo "pre-push: origin/dev not local yet — fetching…"
  git fetch --no-tags origin dev || {
    echo "pre-push: failed to fetch origin/dev; aborting" >&2
    exit 1
  }
fi

echo "pre-push: running \`make lint-new\` (golangci-lint --new-from-merge-base=origin/dev)…"
if ! make lint-new; then
  echo "pre-push: lint-new failed — push blocked." >&2
  echo "  inspect new issues locally; \`make lint\` shows everything (incl. pre-existing)." >&2
  exit 1
fi

echo "pre-push: running \`make web-typecheck\` (tsc --noEmit)…"
if ! make web-typecheck; then
  echo "pre-push: web-typecheck failed — push blocked." >&2
  echo "  fix TS errors in web/src. If tsc is not found: \`cd web && npm install\`." >&2
  exit 1
fi

echo "pre-push: running \`make test\` (go test -race, cached + vitest)…"
if ! make test; then
  echo "pre-push: make test failed — push blocked." >&2
  exit 1
fi

echo "pre-push: OK"
exit 0