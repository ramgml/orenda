[Unit]
Description=Orenda — local-first productivity suite
After=network.target

[Service]
Type=simple
ExecStart=@BINDIR@/orenda serve --config @DATADIR@/config.yaml
WorkingDirectory=@DATADIR@
Restart=on-failure
RestartSec=5
# JWT secret comes from @DATADIR@/env (generated by install.sh on first
# run, mode 600). No default secret is shipped — running without one
# fails fast at startup, which is intentional.
EnvironmentFile=-@DATADIR@/env

[Install]
WantedBy=default.target