[Unit]
Description=Orenda — local-first productivity suite
After=network.target

[Service]
Type=simple
ExecStart=@BINDIR@/orenda serve --config @DATADIR@/config.yaml
WorkingDirectory=@DATADIR@
Restart=on-failure
RestartSec=5
# JWT secret comes from @DATADIR@/env (generated by install.sh on first
# run, mode 600). No default secret is shipped — running without one
# fails fast at startup, which is intentional.
EnvironmentFile=-@DATADIR@/env
# Task 138: mount the JWT secret as a credential instead of an env var —
# credentials do not appear in /proc/*/environ of the service process.
# Requires systemd >= 254 for credentials in the user manager (owner's
# machine runs 255). %h is $HOME and is not touched by install.sh sed
# (which only substitutes @BINDIR@/@DATADIR@).
LoadCredential=jwt:%h/.local/share/orenda/credentials/jwt

[Install]
WantedBy=default.target