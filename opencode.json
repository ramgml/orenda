{
  "$schema": "https://opencode.ai/config.json",
  "theme": "system",
  "model": "minimax/MiniMax-M3",
  "provider": {
    "minimax": {
      "options": {
        "baseURL": "https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1"
      }
    }
  },
  "agent": {
    "build": {
      "model": "minimax/MiniMax-M3",
      "prompt": "You are a senior Go + React developer. Use tools extensively. Follow AGENTS.md and docs/PLAN.md. Run tests after changes. Prefer minimal diffs."
    },
    "plan": {
      "model": "minimax/MiniMax-M3",
      "prompt": "You plan changes without modifying files. Read PRD, PLAN, codebase first. Propose smallest viable change."
    }
  },
  "tools": {
    "bash": {
      "enabled": true
    },
    "edit": {
      "enabled": true
    },
    "write": {
      "enabled": true
    }
  },
  "formatter": {
    "gofmt": true,
    "prettier": true
  },
  "linter": {
    "golangci-lint": true,
    "eslint": true
  }
}