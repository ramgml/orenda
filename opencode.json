{
  "$schema": "https://opencode.ai/config.json",
  "model": "minimax/MiniMax-M3",
  "provider": {
    "minimax": {
      "name": "MiniMax (Alibaba token-plan)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1"
      },
      "models": {
        "MiniMax-M3": {
          "name": "MiniMax M3",
          "reasoning": true,
          "attachment": true,
          "limit": {
            "context": 1000000,
            "output": 32768
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  },
  "agent": {
    "build": {
      "model": "minimax/MiniMax-M3",
      "prompt": "You are a senior Go + React developer. Use tools extensively. Follow AGENTS.md and docs/PLAN.md. Run tests after changes. Prefer minimal diffs."
    },
    "plan": {
      "model": "minimax/MiniMax-M3",
      "prompt": "You plan changes without modifying files. Read PRD, PLAN, codebase first. Propose smallest viable change."
    }
  },
  "tools": {
    "bash": true,
    "edit": true,
    "write": true
  },
  "formatter": true,
  "instructions": [
    "docs/SESSION.md",
    "docs/PRD.md",
    "docs/PLAN.md",
    "AGENTS.md"
  ]
}